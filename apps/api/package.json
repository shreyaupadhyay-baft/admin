{
  "name": "@baft-admin/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --exec \"tsx src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint: TBD - eslint config not yet decided\"",
    "db:migrate": "tsx src/infrastructure/database/run-migrations.ts",
    "db:seed:admin": "tsx src/infrastructure/database/seed-bootstrap-admin.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.4.1",
    "pg": "^8.22.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.7",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
