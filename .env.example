# ── BAFT Admin API ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Dedicated database for BAFT Admin. Do NOT point this at the Baft-Backend
# consumer database — the admin platform owns its own schema/migrations.
DATABASE_URL=postgres://baft_admin:change-me@localhost:5433/baft_admin

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Admin Web frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Transcorp (M2P / Yappay) integration — TBD until credentials are issued ──
# BASE URLs and tenant/partner credentials differ between the KYC host and the
# main Yappay host. Leave blank in environments where Transcorp calls are
# not yet authorized; TranscorpIntegrationService must fail closed, not mock,
# when these are unset in a non-dev environment.
TRANSCORP_KYC_BASE_URL=
TRANSCORP_BASE_URL=
TRANSCORP_TENANT=
TRANSCORP_PARTNER_ID=
TRANSCORP_PARTNER_TOKEN=
TRANSCORP_AUTH_TOKEN=
# Shared secret BAFT expects on inbound Transcorp webhook notifications.
# Transcorp's own webhook auth is a plain header token (no HMAC signing is
# documented) — treat this as the minimum bar, not sufficient on its own;
# the webhook gateway also enforces idempotency/replay protection.
TRANSCORP_WEBHOOK_TOKEN=

# ── Admin Web ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
