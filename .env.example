# ── BAFT Admin API ───────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Dedicated database for BAFT Admin. Do NOT point this at the Baft-Backend
# consumer database — the admin platform owns its own schema/migrations.
DATABASE_URL=postgres://baft_admin:change-me@localhost:5433/baft_admin

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6900

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the Admin Web frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Transcorp integration (foundation) ───────────────────────────────────────
# Full reference: apps/api/src/integrations/transcorp/README.md
# Secrets (marked [SECRET]) come from the environment only — never commit real
# values, never store them in the database. Header NAMES and the auth scheme are
# configuration because the Transcorp production contract is not yet confirmed.
# The integration is OFF unless TRANSCORP_ENABLED=true; BAFT Admin starts and
# works normally without it, and an invalid config fails closed (health reports
# "misconfigured") instead of crashing the process.
TRANSCORP_ENABLED=false
# uat | production. "production" is refused unless NODE_ENV=production.
TRANSCORP_ENVIRONMENT=uat
# bearer | api_key_header | partner_headers | none (none: dev/test only)
TRANSCORP_AUTH_MODE=
# Server-side only, https only (http allowed for loopback mocks outside production).
TRANSCORP_BASE_URL=
TRANSCORP_KYC_BASE_URL=
TRANSCORP_TENANT=
TRANSCORP_KYC_TENANT=
# Header names used by the chosen auth mode / tenant / idempotency (not assumed).
TRANSCORP_AUTH_HEADER_NAME=
TRANSCORP_PARTNER_ID_HEADER=
TRANSCORP_PARTNER_TOKEN_HEADER=
TRANSCORP_TENANT_HEADER=
TRANSCORP_IDEMPOTENCY_HEADER=
# [SECRET] credentials. The KYC host has its own set (credentials are not shared).
TRANSCORP_AUTH_TOKEN=
TRANSCORP_PARTNER_ID=
TRANSCORP_PARTNER_TOKEN=
TRANSCORP_KYC_AUTH_TOKEN=
TRANSCORP_KYC_PARTNER_ID=
TRANSCORP_KYC_PARTNER_TOKEN=
# Timeouts / retries / protection (defaults shown).
# TRANSCORP_TIMEOUT_MS=10000
# TRANSCORP_TOTAL_TIMEOUT_MS=25000
# TRANSCORP_MAX_ATTEMPTS=3
# TRANSCORP_RETRY_BASE_DELAY_MS=250
# TRANSCORP_RETRY_MAX_DELAY_MS=2000
# TRANSCORP_MAX_RESPONSE_BYTES=2097152
# TRANSCORP_MAX_CONCURRENT_REQUESTS=25
# TRANSCORP_CIRCUIT_FAILURE_THRESHOLD=5
# TRANSCORP_CIRCUIT_COOLDOWN_MS=30000
# Provider health probe — TBD until Transcorp names a ping endpoint. Unset => "unverified".
TRANSCORP_HEALTH_PATH=
# main | kyc
# TRANSCORP_HEALTH_HOST=main
# Webhook receiver — enabled only when the token is set. Plain shared header
# token is the minimum bar; HMAC/other schemes plug in via WebhookVerifier.
# [SECRET]
TRANSCORP_WEBHOOK_TOKEN=
TRANSCORP_WEBHOOK_AUTH_HEADER=
TRANSCORP_WEBHOOK_EVENT_ID_HEADER=
# Dotted path to the event type inside the JSON body, e.g. "event.type" (TBD).
TRANSCORP_WEBHOOK_EVENT_TYPE_FIELD=
# TRANSCORP_WEBHOOK_REPLAY_TTL_SECONDS=86400

# ── Admin auth session policy ─────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# ── Bootstrap Super Admin (used only by `npm run db:seed:admin`) ──────────────
# Leave blank once the first Super Admin exists — the script is a no-op then.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=

# ── Admin Web ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000
